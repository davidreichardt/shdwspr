generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Rank {
  RECRUIT
  STRIKER
  SENTINEL
  VANGUARD
  WARDEN
  PARAGON
}

enum Status {
  PENDING
  ACCEPTED
  REJECTED
}

enum SystemRole {
  USER
  MODERATOR
  ADMIN
  SUPERADMIN
}

model User {
  id            Int            @id @default(autoincrement())
  rsiHandle     String?        @unique
  discordId     String         @unique
  discordHandle String         @unique
  preferredName String?
  rank          Rank           @default(RECRUIT)
  application   Application[]  @relation("Applications")
  reviews       Application[]  @relation("Reviews")
  avatar        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  roles         UserRole[]
  hangar        Hangar[]
  UserDivision  UserDivision[]
  systemRole    SystemRole     @default(USER)
}

model Ship {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  manufacturer String
  roles        ShipToRole[]
  size         String
  scu          Int
  hangars      Hangar[]
}

model ShipRole {
  id    Int          @id @default(autoincrement())
  name  String       @unique
  ships ShipToRole[]
}

model ShipToRole {
  id     Int      @id @default(autoincrement())
  ship   Ship     @relation(fields: [shipId], references: [id])
  role   ShipRole @relation(fields: [roleId], references: [id])
  shipId Int
  roleId Int

  @@unique([shipId, roleId])
}

model Hangar {
  id       Int  @id @default(autoincrement())
  user     User @relation(fields: [userId], references: [id])
  ship     Ship @relation(fields: [shipId], references: [id])
  userId   Int
  shipId   Int
  quantity Int  @default(1)

  @@index([userId, shipId])
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  userRoles UserRole[]
}

model UserRole {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])
  userId Int
  roleId Int

  @@unique([userId, roleId])
}

model Division {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  description  String
  slug         String         @unique
  UserDivision UserDivision[]
}

model UserDivision {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  division   Division @relation(fields: [divisionId], references: [id])
  userId     Int
  divisionId Int
  joinedAt   DateTime @default(now())

  @@unique([userId, divisionId])
}

model Application {
  id           Int       @id @default(autoincrement())
  user         User      @relation("Applications", fields: [userId], references: [id])
  userId       Int
  answers      Json
  status       Status    @default(PENDING)
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedBy   User?     @relation("Reviews", fields: [reviewedById], references: [id])
  reviewedById Int?
  notes        String?
  archived     Boolean   @default(false)
}
